# Rust
/target
**/*.rs.bk

# The desktop shell has its own target dir (the rule above is anchored to the root).
/src-tauri/target

# Node (Tauri shell, added in M0)
node_modules/
/dist
/pnpm-lock.yaml

# Generated by tauri-build on every build
/src-tauri/gen

# Local data
*.db
*.db-wal
*.db-shm
/blobs
/thumbs
/logs

# Built installers: rebuilt on every release, so they stay out of history.
# (Attach them to a GitHub Release, or un-ignore these lines if you prefer them in-repo.)
/docs/*.dmg
/docs/*.zip
/docs/*.exe
/docs/PinShot-Windows-*/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
.openidea/

# Local one-off verification crates/scripts
work/
